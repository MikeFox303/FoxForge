# Copy to deployment/docker/.env before docker compose up.
# Generate a high-entropy token, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Keep this value private. The browser asks for it when write controls are unlocked,
# keeps it only in memory for the current tab, and never stores it in localStorage.
FOXFORGE_COMMAND_TOKEN=replace-with-a-random-token-at-least-32-characters

# Automatic pre-dispatch filament-accounting enforcement is disabled by default.
# Candidate 6 physical validation may explicitly use: bambu-validation
# Do not enable that mode for Moonraker/Klipper or general deployments until its
# provider-specific evidence gate is satisfied.
FOXFORGE_FILAMENT_ACCOUNTING_MODE=disabled
